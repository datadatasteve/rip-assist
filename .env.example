# ------------------------------------------------------------------
# Backend (FastAPI) — copy to backend/.env for local dev; use `fly secrets set` in production.
# Frontend values live in frontend/.env (see frontend/.env.example).
# ------------------------------------------------------------------

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Ollama (Tailscale IP first, then fallback). Default model is changeable in Dev → Model registry.
OLLAMA_ENDPOINT=http://100.87.209.56:11434
OLLAMA_FALLBACK_ENDPOINT=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:14b

# Tailscale (Fly only): ephemeral, reusable auth key so the container joins your tailnet
TS_AUTHKEY=

# Cloud AI providers (all optional, only needed if enabled)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_AI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Paid-provider pricing, USD per 1M tokens (update when rates change)
CLAUDE_INPUT_PER_MTOK=1.0
CLAUDE_OUTPUT_PER_MTOK=5.0
OPENAI_INPUT_PER_MTOK=0.15
OPENAI_OUTPUT_PER_MTOK=0.60

# Google Calendar — redirect URI points at the BACKEND callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/callback

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=datamansteve@gmail.com

# App
SECRET_KEY=
CRON_SECRET=
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173/rip-assist/
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://datadatasteve.github.io
